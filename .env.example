# Copy to .env.local and fill in. .env* is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Rows. Bypasses RLS, so this is server-only and must never be
# prefixed NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Storage rejects the sb_secret_ key on this project and still wants
# the legacy JWT. Dashboard -> Settings -> API Keys -> service_role.
SUPABASE_SERVICE_ROLE_JWT=eyJ...

# Not currently used: RLS is on with no policies, so this key can
# read nothing. Kept for when a client ever needs to talk to
# Supabase directly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
